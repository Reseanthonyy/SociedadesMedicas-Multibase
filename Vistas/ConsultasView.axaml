<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:modelos="using:MedicasMultibase.Modelos"
             mc:Ignorable="d"
             x:Class="MedicasMultibase.Vistas.ConsultasView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <!-- ================= FORMULARIO ================= -->
        <Border Grid.Row="0"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20"
                Margin="0,0,0,15">

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- TÍTULO -->
                <TextBlock Grid.ColumnSpan="2"
                           Text="Registrar / Programar Consulta"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B71C1C"
                           Margin="0,0,0,15"/>

                <!-- CENTRO -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Centro *" FontWeight="SemiBold"/>
                    <ComboBox Name="cmbCentros"
                              x:DataType="modelos:Centro"
                              DisplayMemberBinding="{Binding NombreCentro}"
                              PlaceholderText="Seleccione centro"/>
                </StackPanel>

                <!-- EMPLEADO -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                    <TextBlock Text="Empleado *" FontWeight="SemiBold"/>
                    <ComboBox Name="cmbEmpleados"
                              x:DataType="modelos:Personal"
                              DisplayMemberBinding="{Binding Nombre}"
                              PlaceholderText="Seleccione empleado"/>
                </StackPanel>

                <!-- ESPECIALIDAD -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Especialidad *" FontWeight="SemiBold"/>
                    <ComboBox Name="cmbEspecialidades"
                              x:DataType="modelos:Especialidad"
                              DisplayMemberBinding="{Binding NombreEspecialidad}"
                              PlaceholderText="Seleccione especialidad"/>
                </StackPanel>

                <!-- FECHA -->
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                    <TextBlock Text="Fecha *" FontWeight="SemiBold"/>
                    <DatePicker Name="dpFecha"/>
                </StackPanel>

                <!-- HORA -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Hora *" FontWeight="SemiBold"/>
                    <TimePicker Name="tpHora"/>
                </StackPanel>

                <!-- BOTÓN -->
                <Button Grid.Row="3"
                        Grid.Column="1"
                        Content="Agendar Consulta"
                        Name="btnGuardar"
                        Click="BtnGuardar_OnClick"
                        HorizontalAlignment="Right"
                        Width="180"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ================= TABLA ================= -->
        <DataGrid Grid.Row="1"
                  Name="GridConsultas"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding CodigoConsulta}" />

                <DataGridTextColumn Header="Centro"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding CodigoCentro}" />

                <DataGridTextColumn Header="Empleado"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding CodigoEmpleado}" />

                <DataGridTextColumn Header="Especialidad"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding CodigoEspecialidad}" />

                <DataGridTextColumn Header="Fecha"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding DiaSemana, StringFormat={}{0:yyyy-MM-dd}}" />

                <DataGridTextColumn Header="Hora"
                                    x:DataType="modelos:Consulta"
                                    Binding="{Binding Hora}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= ACCIONES ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">

            <Button Content="Eliminar Seleccionado"
                    Name="btnEliminar"
                    Click="BtnEliminar_OnClick"
                    Width="200"
                    Background="White"
                    Foreground="#D32F2F"
                    BorderBrush="#D32F2F"/>
            
            <Button Content="Limpiar"
                    Name="btnLimpiar"
                    Click="BtnLimpiar_OnClick"
                    Width="120"
                    HorizontalAlignment="Center"
                    Background="White"
                    Foreground="#D32F2F"
                    BorderBrush="#D32F2F"/>

            <Button Content="Editar Seleccionado"
                    Name="btnEditar"
                    Click="BtnEditar_OnClick"
                    Width="150"
                    Background="#E0E0E0"/>
            
        </StackPanel>

    </Grid>
</UserControl>